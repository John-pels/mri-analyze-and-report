# Copy to .env.local and fill in. Both keys are optional:
# without them the app uses its built-in template report.

# Google Gemini (tried first) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (used if Gemini fails or is not set) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
